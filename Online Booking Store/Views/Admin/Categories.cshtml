@model AdminCategoriesPageViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Categories";
    var categoryOptions = ((IEnumerable<SelectListItem>)ViewBag.CategoryOptions).ToList();
}

<div class="row g-4">
    <div class="col-xl-6">
        <div class="admin-panel-card">
            <div class="admin-card-header">
                <div><h3 class="mb-1">Categories</h3><p>Main product groups used throughout the catalog.</p></div>
                <button class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#addCategoryModal">Add</button>
            </div>
            <div class="table-shell">
                <table class="table admin-table">
                    <thead><tr><th>Code</th><th>Name</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var category in Model.Categories)
                        {
                            <tr>
                                <td>@category.CategoryCode</td>
                                <td>@category.CategoryName</td>
                                <td><span class="status-badge @(category.IsActive ? "completed" : "cancelled")">@(category.IsActive ? "Active" : "Inactive")</span></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#editCategoryModal-@category.CategoryId">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteCategoryModal-@category.CategoryId">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="admin-panel-card">
            <div class="admin-card-header">
                <div><h3 class="mb-1">Sub Categories</h3><p>Detailed product groups under each category.</p></div>
                <button class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#addSubCategoryModal">Add</button>
            </div>
            <div class="table-shell">
                <table class="table admin-table">
                    <thead><tr><th>Code</th><th>Name</th><th>Category</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var subCategory in Model.SubCategories)
                        {
                            <tr>
                                <td>@subCategory.SubCategoryCode</td>
                                <td>@subCategory.SubCategoryName</td>
                                <td>@subCategory.Category?.CategoryName</td>
                                <td><span class="status-badge @(subCategory.IsActive ? "completed" : "cancelled")">@(subCategory.IsActive ? "Active" : "Inactive")</span></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#editSubCategoryModal-@subCategory.SubCategoryId">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteSubCategoryModal-@subCategory.SubCategoryId">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addCategoryModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Add Category</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><form asp-action="AddCategory" method="post" class="row g-3">@Html.AntiForgeryToken()<div class="col-md-4"><label class="form-label">Code</label><input class="form-control" name="CategoryCode" /></div><div class="col-md-8"><label class="form-label">Name</label><input class="form-control" name="CategoryName" /></div><div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" name="IsActive" value="true" checked /><label class="form-check-label">Active</label></div></div><div class="col-12 text-end"><button class="btn btn-dark" type="submit">Save</button></div></form></div></div></div></div>

<div class="modal fade" id="addSubCategoryModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Add Sub Category</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><form asp-action="AddSubCategory" method="post" class="row g-3">@Html.AntiForgeryToken()<div class="col-md-4"><label class="form-label">Code</label><input class="form-control" name="SubCategoryCode" /></div><div class="col-md-8"><label class="form-label">Name</label><input class="form-control" name="SubCategoryName" /></div><div class="col-12"><label class="form-label">Category</label><select class="form-select" name="CategoryId">@foreach (var category in categoryOptions){<option value="@category.Value">@category.Text</option>}</select></div><div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" name="IsActive" value="true" checked /><label class="form-check-label">Active</label></div></div><div class="col-12 text-end"><button class="btn btn-dark" type="submit">Save</button></div></form></div></div></div></div>

@foreach (var category in Model.Categories)
{
    <div class="modal fade" id="editCategoryModal-@category.CategoryId" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Edit Category</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><form asp-action="EditCategory" method="post" class="row g-3">@Html.AntiForgeryToken()<input type="hidden" name="CategoryId" value="@category.CategoryId" /><div class="col-md-4"><label class="form-label">Code</label><input class="form-control" name="CategoryCode" value="@category.CategoryCode" /></div><div class="col-md-8"><label class="form-label">Name</label><input class="form-control" name="CategoryName" value="@category.CategoryName" /></div><div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" name="IsActive" value="true" checked="@category.IsActive" /><label class="form-check-label">Active</label></div></div><div class="col-12 text-end"><button class="btn btn-dark" type="submit">Save</button></div></form></div></div></div></div>
    <div class="modal fade" id="deleteCategoryModal-@category.CategoryId" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Delete Category</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><p>Delete <strong>@category.CategoryName</strong>?</p><form asp-action="DeleteCategory" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@category.CategoryId" /><button class="btn btn-danger" type="submit">Confirm Delete</button></form></div></div></div></div>
}

@foreach (var subCategory in Model.SubCategories)
{
    <div class="modal fade" id="editSubCategoryModal-@subCategory.SubCategoryId" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Edit Sub Category</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><form asp-action="EditSubCategory" method="post" class="row g-3">@Html.AntiForgeryToken()<input type="hidden" name="SubCategoryId" value="@subCategory.SubCategoryId" /><div class="col-md-4"><label class="form-label">Code</label><input class="form-control" name="SubCategoryCode" value="@subCategory.SubCategoryCode" /></div><div class="col-md-8"><label class="form-label">Name</label><input class="form-control" name="SubCategoryName" value="@subCategory.SubCategoryName" /></div><div class="col-12"><label class="form-label">Category</label><select class="form-select" name="CategoryId">@foreach (var category in categoryOptions){<option value="@category.Value" selected="@(subCategory.CategoryId.ToString() == category.Value)">@category.Text</option>}</select></div><div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" name="IsActive" value="true" checked="@subCategory.IsActive" /><label class="form-check-label">Active</label></div></div><div class="col-12 text-end"><button class="btn btn-dark" type="submit">Save</button></div></form></div></div></div></div>
    <div class="modal fade" id="deleteSubCategoryModal-@subCategory.SubCategoryId" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Delete Sub Category</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><p>Delete <strong>@subCategory.SubCategoryName</strong>?</p><form asp-action="DeleteSubCategory" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@subCategory.SubCategoryId" /><button class="btn btn-danger" type="submit">Confirm Delete</button></form></div></div></div></div>
}
