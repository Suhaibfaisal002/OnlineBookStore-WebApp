@model AdminOrdersPageViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Orders";
}

<div class="admin-panel-card">
    <div class="admin-card-header">
        <div>
            <h3 class="mb-1">Orders</h3>
            <p>Track payments, statuses, and customer activity.</p>
        </div>
        <form class="d-flex gap-2" method="get">
            <select class="form-select" name="status" style="min-width: 180px;">
                <option value="">Any status</option>
                <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending</option>
                <option value="Processing" selected="@(Model.StatusFilter == "Processing")">Processing</option>
                <option value="Dispatched" selected="@(Model.StatusFilter == "Dispatched")">Dispatched</option>
                <option value="Delivered" selected="@(Model.StatusFilter == "Delivered")">Delivered</option>
                <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
            </select>
            <button class="btn btn-dark" type="submit">Filter</button>
        </form>
    </div>
    <div class="table-shell">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>Order Number</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td>@order.OrderNumber</td>
                        <td>@order.User?.FullName</td>
                        <td>@order.OrderDate.ToString("dd MMM yyyy")</td>
                        <td>@order.GrandTotal.ToString("C")</td>
                        <td><span class="status-badge @order.OrderStatus.ToLowerInvariant()">@order.OrderStatus</span></td>
                        <td>@order.PaymentType / @order.PaymentStatus</td>
                        <td><a class="btn btn-sm btn-outline-dark" asp-action="OrderDetail" asp-route-orderId="@order.OrderId">View Detail</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
