@model AdminCustomersPageViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Customers";
}

<div class="admin-panel-card">
    <div class="admin-card-header">
        <div>
            <h3 class="mb-1">Customers</h3>
            <p>Registered users who can place and track orders.</p>
        </div>
        <div class="d-flex gap-2">
            <form class="d-flex gap-2" method="get" asp-action="SearchCustomers">
                <input class="form-control" type="search" name="searchTerm" value="@Model.SearchTerm" placeholder="Search by name, email or phone" style="min-width: 300px;" />
                <button class="btn btn-outline-dark" type="submit">Search</button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a href="@Url.Action("Customers")" class="btn btn-outline-secondary">Clear</a>
                }
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SearchTerm))
    {
        <div class="alert alert-info mb-3">
            Showing results for: <strong>@Model.SearchTerm</strong>
        </div>
    }

    <div class="table-shell">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>City</th>
                    <th>Joined</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Customers != null && Model.Customers.Any())
                {
                    @foreach (var customer in Model.Customers)
                    {
                        <tr>
                            <td>@customer.FullName</td>
                            <td>@customer.Email</td>
                            <td>@(!string.IsNullOrEmpty(customer.Phone) ? customer.Phone : "—")</td>
                            <td>@(!string.IsNullOrEmpty(customer.City) ? customer.City : "—")</td>
                            <td>@customer.CreatedDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal-@customer.UserId">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4">
                            No customers found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Modals -->
@foreach (var customer in Model.Customers)
{
    <div class="modal fade" id="deleteModal-@customer.UserId" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Customer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Delete <strong>@customer.FullName</strong>?</p>
                    <p class="text-danger mb-0">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <form asp-action="DeleteCustomer" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@customer.UserId" />
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}