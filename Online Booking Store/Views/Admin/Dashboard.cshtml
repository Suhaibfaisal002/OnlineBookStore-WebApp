@model DashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
}

<section class="dashboard-hero">
    <div class="dashboard-hero-header">
        <div>
            <p class="admin-topbar-label">Overview</p>
            <h2 class="mb-1">Live Store Pulse</h2>
            <p class="text-muted mb-0">Track orders, revenue, and customer activity in real time.</p>
        </div>
        <div class="dashboard-actions">
            <a class="btn btn-outline-dark" asp-action="Products">Add Product</a>
            <a class="btn btn-dark" asp-action="Orders">Manage Orders</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-xl-3">
            <div class="metric-card metric-highlight">
                <p>Total Revenue</p>
                <h3>@Model.TotalRevenue.ToString("C")</h3>
                <span class="metric-caption">Avg order @Model.AverageOrderValue.ToString("C")</span>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="metric-card">
                <p>Total Orders</p>
                <h3>@Model.TotalOrders</h3>
                <span class="metric-caption">@Model.PendingOrders pending approvals</span>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="metric-card">
                <p>Total Products</p>
                <h3>@Model.TotalProducts</h3>
                <span class="metric-caption">@Model.UnresolvedFeedbacks feedbacks open</span>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="metric-card">
                <p>Total Customers</p>
                <h3>@Model.TotalCustomers</h3>
                <span class="metric-caption">@Model.DeliveredOrders delivered orders</span>
            </div>
        </div>
    </div>
</section>

<section class="admin-panel-card dashboard-panel">
    <div class="admin-card-header">
        <div>
            <h3 class="mb-1">Recent Orders</h3>
            <p>Latest customer orders at a glance.</p>
        </div>
        <a class="btn btn-outline-dark" asp-action="Orders">View All Orders</a>
    </div>
    <div class="table-shell">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Customer</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th>Date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.RecentOrders)
                {
                    <tr>
                        <td>@order.OrderNumber</td>
                        <td>@order.User?.FullName</td>
                        <td><span class="status-badge @order.OrderStatus.ToLowerInvariant()">@order.OrderStatus</span></td>
                        <td>@order.GrandTotal.ToString("C")</td>
                        <td>@order.OrderDate.ToString("dd MMM yyyy")</td>
                        <td><a class="btn btn-sm btn-outline-dark" asp-action="OrderDetail" asp-route-orderId="@order.OrderId">View</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="admin-panel-card dashboard-panel">
    <div class="admin-card-header">
        <div>
            <h3 class="mb-1">Customer Experience</h3>
            <p>Quick actions for feedback and catalog management.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-dark" asp-action="Feedbacks">Feedback Inbox</a>
            <a class="btn btn-dark" asp-action="Products">Manage Products</a>
        </div>
    </div>
    <div class="dashboard-grid">
        <div class="dashboard-card">
            <h4>@Model.UnresolvedFeedbacks</h4>
            <p>Open feedback requests</p>
            <a asp-action="Feedbacks">Review feedback</a>
        </div>
        <div class="dashboard-card">
            <h4>@Model.TotalProducts</h4>
            <p>Products live in catalog</p>
            <a asp-action="Products">Update catalog</a>
        </div>
        <div class="dashboard-card">
            <h4>@Model.TotalCustomers</h4>
            <p>Registered customers</p>
            <a asp-action="Customers">View customers</a>
        </div>
        <div class="dashboard-card">
            <h4>@Model.PendingOrders</h4>
            <p>Orders awaiting action</p>
            <a asp-action="Orders">Prioritize orders</a>
        </div>
    </div>
</section>

