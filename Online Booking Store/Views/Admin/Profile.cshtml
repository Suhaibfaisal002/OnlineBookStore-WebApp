@model ProfileViewModel
@inject IConfiguration Configuration
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Profile";
    var logoPath = Configuration["ApplicationSettings:LogoPath"] ?? "/Images/Brand/store-logo.png";
}

<div class="admin-panel-card">
    <div class="admin-card-header">
        <div>
            <h3 class="mb-1">Profile Settings</h3>
            <p>Update your admin contact details and profile photo.</p>
        </div>
    </div>
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="content-card profile-card profile-card-admin">
                <div class="profile-avatar-lg">
                    @if (!string.IsNullOrWhiteSpace(Model.ProfileImagePath))
                    {
                        <img src="@Model.ProfileImagePath" alt="@Model.FullName" />
                    }
                    else
                    {
                        <span>@(string.IsNullOrWhiteSpace(Model.FullName) ? "A" : Model.FullName[..1].ToUpper())</span>
                    }
                </div>
                <h2 class="mb-1">@Model.FullName</h2>
                <p class="text-muted mb-3">@Model.Email</p>
                <div class="profile-meta">
                    <div>
                        <span>Role</span>
                        <strong>Administrator</strong>
                    </div>
                    <div>
                        <span>Orders</span>
                        <strong>@Model.OrdersCount</strong>
                    </div>
                </div>
                <div class="profile-address">
                    <p class="text-muted mb-1">Contact</p>
                    <strong>@(Model.Phone ?? "Not provided")</strong>
                    <span class="d-block text-muted">@(Model.City ?? "City not set")</span>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="content-card">
                <form asp-action="UpdateProfile" method="post" enctype="multipart/form-data" class="row g-3">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="City" class="form-label"></label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Address" class="form-label"></label>
                        <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="ProfileImage" class="form-label">Profile Photo</label>
                        <input asp-for="ProfileImage" class="form-control" type="file" accept="image/*" />
                    </div>
                    <div class="col-12 text-end">
                        <button class="btn btn-dark px-4" type="submit">Save Changes</button>
                    </div>
                </form>
            </div>
            <div class="content-card mt-4">
                <div class="section-heading">
                    <div>
                        <h4 class="section-title mb-1">Store Branding</h4>
                        <p>Update the logo shown on the website and admin panel.</p>
                    </div>
                </div>
                <div class="brand-logo-preview">
                    <img src="@logoPath" alt="Store logo" />
                </div>
                <form asp-action="UpdateBrandLogo" method="post" enctype="multipart/form-data" class="row g-3 mt-2">
                    @Html.AntiForgeryToken()
                    <div class="col-12">
                        <label class="form-label">Upload New Logo</label>
                        <input class="form-control" type="file" name="logoFile" accept="image/*" />
                    </div>
                    <div class="col-12 text-end">
                        <button class="btn btn-outline-dark px-4" type="submit">Update Logo</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
