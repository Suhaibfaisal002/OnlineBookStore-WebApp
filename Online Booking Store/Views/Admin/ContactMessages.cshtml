@model AdminContactMessagesPageViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Contact Messages";
}

<div class="admin-panel-card">
    <div class="admin-card-header">
        <div>
            <h3 class="mb-1">Contact Messages</h3>
            <p>View and manage customer inquiries from the contact form.</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-primary py-2 px-3">
                <i class="bi bi-envelope me-2"></i>Total: @Model.TotalMessages
            </span>
            <button class="btn btn-outline-danger" id="deleteSelectedBtn" disabled onclick="deleteSelected()">
                <i class="bi bi-trash me-2"></i>Delete Selected
            </button>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mx-3 mt-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mx-3 mt-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="table-shell">
        <table class="table admin-table" id="messagesTable">
            <thead>
                <tr>
                    <th width="40">
                        <input type="checkbox" id="selectAll" onclick="toggleAll(this)">
                    </th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Subject</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var message in Model.ContactMessages)
                {
                    <tr>
                        <td>
                            <input type="checkbox" class="message-checkbox" value="@message.Id" onchange="updateDeleteButton()">
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="avatar-circle bg-primary bg-opacity-10 me-2">
                                    <span class="text-primary">@message.Name.Substring(0, 1).ToUpper()</span>
                                </div>
                                @message.Name
                            </div>
                        </td>
                        <td>
                            <a href="mailto:@message.Email" class="text-decoration-none">
                                <i class="bi bi-envelope me-1"></i>@message.Email
                            </a>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(message.Phone) && message.Phone != "Not provided")
                            {
                                <a href="tel:@message.Phone" class="text-decoration-none">
                                    <i class="bi bi-telephone me-1"></i>@message.Phone
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            <span class="fw-semibold">@message.Subject</span>
                        </td>
                        <td>
                            <div class="d-flex flex-column">
                                <span>@message.CreatedAt.ToString("dd MMM yyyy")</span>
                                <small class="text-muted">@message.CreatedAt.ToString("hh:mm tt")</small>
                            </div>
                        </td>
                        <td>
                            <div class="action-buttons">
                                <button class="btn btn-sm btn-outline-primary" onclick="viewMessage(@message.Id)" title="View Details">
                                    <i class="bi bi-eye">Details</i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteSingle(@message.Id)" title="Delete">
                                    <i class="bi bi-trash">Delete</i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.ContactMessages.Any())
        {
            <div class="text-center py-5">
                <div class="mb-3">
                    <i class="bi bi-envelope-open" style="font-size: 4rem; color: #dee2e6;"></i>
                </div>
                <h5 class="text-muted">No messages yet</h5>
                <p class="text-muted">Customer inquiries will appear here.</p>
            </div>
        }
    </div>
</div>

<!-- View Message Modal -->
<div class="modal fade" id="viewMessageModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Message Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="messageDetailsContent">
                <!-- Content will be loaded here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Single Confirmation Modal -->
<div class="modal fade" id="deleteSingleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this message?</p>
                <p class="text-muted small">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteSingleForm" method="post" asp-action="DeleteContactMessage" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteMessageId" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Delete Multiple Confirmation Modal -->
<div class="modal fade" id="deleteMultipleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete Multiple</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <span id="selectedCount">0</span> selected message(s)?</p>
                <p class="text-muted small">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteMultipleForm" method="post" asp-action="DeleteMultipleContactMessages">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="messageIds" id="selectedMessageIds" />
                    <button type="submit" class="btn btn-danger">Delete All</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .avatar-circle {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 14px;
        }

        .action-buttons {
            display: flex;
            gap: 5px;
        }

            .action-buttons .btn {
                padding: 0.25rem 0.5rem;
                font-size: 0.875rem;
            }

                .action-buttons .btn i {
                    font-size: 1rem;
                }

        .message-checkbox, #selectAll {
            cursor: pointer;
            width: 18px;
            height: 18px;
        }

        .badge {
            font-size: 0.875rem;
            font-weight: 500;
        }

        .admin-table tbody tr:hover {
            background-color: #f8f9fa;
            cursor: pointer;
        }
    </style>
}

@section Scripts {
    <script>
        let selectedMessages = [];

        // View single message details
        function viewMessage(id) {
            fetch(`/Admin/GetContactMessageDetails/${id}`)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('messageDetailsContent').innerHTML = html;
                    var modal = new bootstrap.Modal(document.getElementById('viewMessageModal'));
                    modal.show();
                })
                .catch(error => console.error('Error:', error));
        }

        // Delete single message
        function deleteSingle(id) {
            document.getElementById('deleteMessageId').value = id;
            var modal = new bootstrap.Modal(document.getElementById('deleteSingleModal'));
            modal.show();
        }

        // Toggle all checkboxes
        function toggleAll(source) {
            const checkboxes = document.getElementsByClassName('message-checkbox');
            for (let i = 0; i < checkboxes.length; i++) {
                checkboxes[i].checked = source.checked;
            }
            updateSelectedMessages();
            updateDeleteButton();
        }

        // Update selected messages array
        function updateSelectedMessages() {
            selectedMessages = [];
            const checkboxes = document.getElementsByClassName('message-checkbox');
            for (let i = 0; i < checkboxes.length; i++) {
                if (checkboxes[i].checked) {
                    selectedMessages.push(checkboxes[i].value);
                }
            }
            document.getElementById('selectedMessageIds').value = selectedMessages.join(',');
        }

        // Update delete button state
        function updateDeleteButton() {
            updateSelectedMessages();
            const deleteBtn = document.getElementById('deleteSelectedBtn');
            deleteBtn.disabled = selectedMessages.length === 0;
            if (selectedMessages.length > 0) {
                deleteBtn.innerHTML = `<i class="bi bi-trash me-2"></i>Delete Selected (${selectedMessages.length})`;
            } else {
                deleteBtn.innerHTML = `<i class="bi bi-trash me-2"></i>Delete Selected`;
            }
        }

        // Delete selected messages
        function deleteSelected() {
            if (selectedMessages.length > 0) {
                document.getElementById('selectedCount').textContent = selectedMessages.length;
                var modal = new bootstrap.Modal(document.getElementById('deleteMultipleModal'));
                modal.show();
            }
        }

        // Handle row click to select checkbox
        document.addEventListener('DOMContentLoaded', function() {
            const rows = document.querySelectorAll('.admin-table tbody tr');
            rows.forEach(row => {
                row.addEventListener('click', function(e) {
                    // Don't trigger if clicking on buttons, links, or checkboxes
                    if (e.target.tagName === 'BUTTON' ||
                        e.target.tagName === 'A' ||
                        e.target.tagName === 'I' ||
                        e.target.type === 'checkbox') {
                        return;
                    }
                    
                    const checkbox = this.querySelector('.message-checkbox');
                    if (checkbox) {
                        checkbox.checked = !checkbox.checked;
                        updateDeleteButton();
                    }
                });
            });
        });

        // Auto-hide alerts after 5 seconds
        setTimeout(function() {
            document.querySelectorAll('.alert').forEach(alert => {
                alert.style.transition = 'opacity 0.5s';
                alert.style.opacity = '0';
                setTimeout(() => alert.remove(), 500);
            });
        }, 5000);
    </script>
}