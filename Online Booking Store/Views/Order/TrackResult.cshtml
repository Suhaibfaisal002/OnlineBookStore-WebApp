@model Order
@{
    ViewData["Title"] = "Tracking Result";
    string statusClass = Model.OrderStatus.ToLowerInvariant();
}

<div class="content-card">
    <div class="section-heading">
        <div>
            <h1 class="section-title mb-1">Order @Model.OrderNumber</h1>
            <p>Placed on @Model.OrderDate.ToString("dd MMM yyyy hh:mm tt")</p>
        </div>
        <span class="status-badge @statusClass">@Model.OrderStatus</span>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="metric-card">
                <p>Payment</p>
                <h3>@Model.PaymentType / @Model.PaymentStatus</h3>
            </div>
        </div>
        <div class="col-md-6">
            <div class="metric-card">
                <p>Grand Total</p>
                <h3>@Model.GrandTotal.ToString("C")</h3>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderItems)
                {
                    <tr>
                        <td>@item.Product?.ProductName</td>
                        <td>@item.Quantity</td>
                        <td>@item.UnitPrice.ToString("C")</td>
                        <td>@item.SubTotal.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between flex-wrap gap-2 mt-4">
        <div>
            <div><strong>Delivery Charge:</strong> @Model.DeliveryCharge.ToString("C")</div>
            <div><strong>Discount:</strong> @Model.DiscountAmount.ToString("C")</div>
        </div>
        <div class="d-flex gap-2">
            @if (Model.OrderStatus is not "Delivered" and not "Cancelled")
            {
                <a class="btn btn-outline-danger" asp-action="CancelOrder" asp-route-orderNumber="@Model.OrderNumber" asp-route-email="@Model.User?.Email">Cancel Order</a>
            }
            @if (Model.OrderStatus is "Pending" or "Processing")
            {
                <a class="btn btn-dark" asp-action="UpdateOrder" asp-route-orderNumber="@Model.OrderNumber">Update Order</a>
            }
        </div>
    </div>
</div>
