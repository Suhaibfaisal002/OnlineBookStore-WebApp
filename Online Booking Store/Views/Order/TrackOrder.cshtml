@model TrackOrderViewModel
@{
    ViewData["Title"] = "Order Tracking";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="content-card">
            <h1 class="mb-3">Track your order</h1>
            <form asp-action="TrackResult" method="post" class="row g-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="col-12">
                    <label asp-for="OrderNumber" class="form-label"></label>
                    <input asp-for="OrderNumber" class="form-control" />
                    <span asp-validation-for="OrderNumber" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <button class="btn btn-dark w-100" type="submit">Track Order</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
