@{
    ViewData["Title"] = "Order Success";
}

<div class="content-card text-center">
    <span class="badge text-bg-success mb-3">Order Confirmed</span>
    <h1 class="mb-3">Thank you for your order</h1>
    <p class="text-muted">Your order number is:</p>
    <div class="display-5 fw-bold mb-4">@ViewBag.OrderNumber</div>
    <div class="d-flex justify-content-center gap-3 flex-wrap">
        <a class="btn btn-dark" asp-action="TrackOrder">Track Your Order</a>
        <a class="btn btn-outline-dark" asp-controller="Product" asp-action="Index">Continue Shopping</a>
    </div>
</div>
