@model ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Product.ProductName;
}

<div class="content-card product-detail-hero">
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="product-image-shell">
                <img src="@(string.IsNullOrWhiteSpace(Model.Product.ImagePath) ? "/favicon.ico" : Model.Product.ImagePath)" alt="@Model.Product.ProductName" />
            </div>
        </div>
        <div class="col-lg-7">
            <div class="product-badges">
                <span class="badge text-bg-light">@Model.Product.Category?.CategoryName</span>
                <span class="badge text-bg-dark">@Model.Product.ProductType</span>
                <span class="badge text-bg-light">@Model.Product.SubCategory?.SubCategoryName</span>
            </div>
            <h1 class="mb-2">@Model.Product.ProductName</h1>
            <p class="text-muted mb-2">Code: @Model.Product.ProductCode</p>
            <div class="rating-row mb-3">
                <div class="rating-stars">
                    @for (var i = 1; i <= 5; i++)
                    {
                        <span class="@(i <= Math.Round(Model.RatingSummary.AverageRating) ? "filled" : "")">★</span>
                    }
                </div>
                <small class="text-muted">@Model.RatingSummary.AverageRating.ToString("0.0") (@Model.RatingSummary.ReviewCount reviews)</small>
            </div>
            <p class="price fs-3">@Model.Product.Price.ToString("C")</p>
            <p class="lead">@Model.Product.Description</p>

            <div class="row row-cols-1 row-cols-md-2 g-3 mb-4">
                <div><strong>Author:</strong> @(Model.Product.AuthorName ?? "N/A")</div>
                <div><strong>Publisher:</strong> @(Model.Product.PublisherName ?? "N/A")</div>
                <div><strong>Release Date:</strong> @(Model.Product.ReleaseDate?.ToString("dd MMM yyyy") ?? "N/A")</div>
                <div><strong>Type:</strong> @Model.Product.ProductType</div>
                <div><strong>Stock:</strong> @(Model.Product.StockQuantity > 0 ? "Available" : "Out of stock")</div>
                <div><strong>Brand:</strong> @(Model.Product.Manufacturer?.ManufacturerName ?? "N/A")</div>
            </div>

            <form asp-action="AddToCart" method="post" class="row g-3 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.Product.ProductId" />
                <div class="col-sm-4">
                    <label class="form-label">Quantity</label>
                    <input class="form-control" type="number" name="quantity" value="@Model.Quantity" min="1" max="@Math.Max(Model.Product.StockQuantity, 1)" />
                </div>
                <div class="col-sm-4">
                    <button type="submit" class="btn btn-dark w-100">Add to Cart</button>
                </div>
                <div class="col-sm-4">
                    <button type="submit" formaction="@Url.Action("AddToCart", "Product")" name="returnUrl" value="@Url.Action("Checkout", "Cart")" class="btn btn-outline-dark w-100">Buy Now</button>
                </div>
            </form>
        </div>
    </div>
</div>

<section class="review-section mt-4">
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="content-card rating-summary-card">
                <h3 class="mb-2">Customer Ratings</h3>
                <div class="rating-summary">
                    <div class="rating-score">
                        <h2>@Model.RatingSummary.AverageRating.ToString("0.0")</h2>
                        <div class="rating-stars">
                            @for (var i = 1; i <= 5; i++)
                            {
                                <span class="@(i <= Math.Round(Model.RatingSummary.AverageRating) ? "filled" : "")">★</span>
                            }
                        </div>
                        <p class="text-muted mb-0">@Model.RatingSummary.ReviewCount reviews</p>
                    </div>
                    <div class="rating-bars">
                        @foreach (var entry in Model.RatingBreakdown.OrderByDescending(x => x.Key))
                        {
                            var percent = Model.RatingSummary.ReviewCount == 0 ? 0 : (int)Math.Round(100.0 * entry.Value / Model.RatingSummary.ReviewCount);
                            <div class="rating-bar">
                                <span>@entry.Key star</span>
                                <div class="progress">
                                    <div class="progress-bar" style="width: @percent%"></div>
                                </div>
                                <small>@entry.Value</small>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="content-card review-guidelines mt-4">
                <h4 class="mb-2">Review Guidelines</h4>
                <ul class="list-unstyled mb-0">
                    <li>Be specific about quality and experience.</li>
                    <li>Share practical tips for other buyers.</li>
                    <li>Keep it respectful and honest.</li>
                </ul>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="content-card review-list">
                <div class="section-heading">
                    <div>
                        <h2 class="section-title mb-1">Reviews & Comments</h2>
                        <p>Latest feedback from verified buyers and readers.</p>
                    </div>
                </div>

                @if (Model.Reviews.Count == 0)
                {
                    <div class="empty-state">
                        <h4>No reviews yet</h4>
                        <p>Be the first to share your thoughts on this product.</p>
                    </div>
                }
                else
                {
                    <div class="d-grid gap-3">
                        @foreach (var review in Model.Reviews)
                        {
                            <div class="review-card">
                                <div class="review-header">
                                    <div class="reviewer">
                                        <div class="reviewer-avatar">
                                            @if (!string.IsNullOrWhiteSpace(review.ReviewerImagePath))
                                            {
                                                <img src="@review.ReviewerImagePath" alt="@review.ReviewerName" />
                                            }
                                            else
                                            {
                                                <span>@(string.IsNullOrWhiteSpace(review.ReviewerName) ? "U" : review.ReviewerName[..1])</span>
                                            }
                                        </div>
                                        <div>
                                            <strong>@review.ReviewerName</strong>
                                            <small class="text-muted d-block">@review.CreatedOn.ToString("dd MMM yyyy")</small>
                                        </div>
                                    </div>
                                    <div class="review-rating">
                                        <div class="rating-stars">
                                            @for (var i = 1; i <= 5; i++)
                                            {
                                                <span class="@(i <= review.Rating ? "filled" : "")">★</span>
                                            }
                                        </div>
                                        @if (review.IsVerifiedPurchase)
                                        {
                                            <span class="verified-pill">Verified purchase</span>
                                        }
                                    </div>
                                </div>
                                <h5 class="mb-1">@review.Title</h5>
                                <p class="mb-0">@review.Comment</p>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="content-card review-form mt-4">
                <h3 class="mb-2">@(Model.HasReviewed ? "Write another review" : "Write a review")</h3>
                @if (Model.HasReviewed)
                {
                    <p class="text-muted">You can post multiple reviews for different experiences.</p>
                }
                @if (Model.CanReview)
                {
                    <form asp-action="AddReview" asp-route-productCode="@Model.Product.ProductCode" method="post" class="row g-3">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="col-12">
                            <label asp-for="ReviewForm.Rating" class="form-label">Rating</label>
                            <select asp-for="ReviewForm.Rating" class="form-select">
                                <option value="5">5 - Excellent</option>
                                <option value="4">4 - Very Good</option>
                                <option value="3">3 - Good</option>
                                <option value="2">2 - Fair</option>
                                <option value="1">1 - Poor</option>
                            </select>
                            <span asp-validation-for="ReviewForm.Rating" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="ReviewForm.Title" class="form-label">Title</label>
                            <input asp-for="ReviewForm.Title" class="form-control" />
                            <span asp-validation-for="ReviewForm.Title" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="ReviewForm.Comment" class="form-label">Comment</label>
                            <textarea asp-for="ReviewForm.Comment" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="ReviewForm.Comment" class="text-danger"></span>
                        </div>
                        <div class="col-12 text-end">
                            <button class="btn btn-dark px-4" type="submit">Submit Review</button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="empty-state">
                        <h4>Login to leave a review</h4>
                        <p>Sign in with your customer account to share feedback.</p>
                        <a class="btn btn-outline-dark" asp-controller="Customer" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Login</a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
