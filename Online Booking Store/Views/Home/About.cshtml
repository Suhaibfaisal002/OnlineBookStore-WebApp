@{
    ViewData["Title"] = "About Us";
}

<section class="content-card">
    <div class="row g-4 align-items-center">
        <div class="col-lg-7">
            <span class="badge text-bg-dark mb-3">About Shradha Book Stores</span>
            <h1 class="mb-3">A traditional neighborhood book shop, now made easier online.</h1>
            <p>Our client started as a trusted local retail dealer serving students, readers, and stationery buyers. The goal of this platform is to bring that same warmth online while making ordering, tracking, and customer communication faster and more reliable.</p>
            <p class="mb-0">You can browse books, magazines, CDs, DVDs, utilities, and more while enjoying clear delivery rules, multiple payment options, and easy support.</p>
        </div>
        <div class="col-lg-5">
            <div class="metric-card">
                <p>What we offer</p>
                <h3>Books, magazines, utilities, and guided order tracking</h3>
            </div>
            <div class="metric-card mt-3">
                <p>Service promise</p>
                <h3>Free delivery within 3 KM and responsive support</h3>
            </div>
        </div>
    </div>
</section>
