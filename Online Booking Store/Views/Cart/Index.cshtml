@model CartViewModel
@{
    ViewData["Title"] = "Cart";
}

<div class="content-card">
    <div class="section-heading">
        <div>
            <h1 class="section-title mb-1">Your Cart</h1>
            <p>Review quantities and proceed when you are ready.</p>
        </div>
        <a class="btn btn-dark" asp-action="Checkout">Proceed to Checkout</a>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="empty-state">
            <h4>Your cart is empty</h4>
            <p>Add products from the catalog to begin your order.</p>
            <a class="btn btn-dark" asp-controller="Product" asp-action="Index">Browse Products</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Unit Price</th>
                        <th>Quantity</th>
                        <th>Subtotal</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(string.IsNullOrWhiteSpace(item.ImagePath) ? "/favicon.ico" : item.ImagePath)" alt="@item.ProductName" style="width: 64px; height: 64px; object-fit: cover; border-radius: 12px;" />
                                    <div>
                                        <strong>@item.ProductName</strong>
                                        <div class="text-muted small">@item.ProductCode</div>
                                    </div>
                                </div>
                            </td>
                            <td>@item.UnitPrice.ToString("C")</td>
                            <td>
                                <form asp-action="UpdateQuantity" method="post" class="d-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="cartId" value="@item.CartId" />
                                    <input class="form-control" style="max-width: 90px;" type="number" name="quantity" value="@item.Quantity" min="0" />
                                    <button class="btn btn-outline-dark" type="submit">Update</button>
                                </form>
                            </td>
                            <td>@item.SubTotal.ToString("C")</td>
                            <td>
                                <form asp-action="RemoveItem" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="cartId" value="@item.CartId" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <div class="content-card" style="max-width: 340px;">
                <h5>Cart Summary</h5>
                <div class="d-flex justify-content-between"><span>Total Items</span><strong>@Model.TotalQuantity</strong></div>
                <div class="d-flex justify-content-between mt-2"><span>Total Amount</span><strong>@Model.TotalAmount.ToString("C")</strong></div>
                <a class="btn btn-dark w-100 mt-3" asp-action="Checkout">Proceed to Checkout</a>
            </div>
        </div>
    }
</div>
